# Copy to .env and fill in. Never commit .env. Every line is optional.
# A variable already set in your shell wins over this file. Text after " #" on a line is a comment.

# ---------------- AI provider: pick the default, then optional backups ----------------
# LLM_PROVIDER: claude | groq | gemini | auto | offline
#   auto    = the first provider that has a key, in the order claude, groq, gemini
#   offline = never call any AI (built-in fallbacks only)
LLM_PROVIDER=auto
# LLM_FALLBACK: backups tried in order if the default fails (rate limit, outage, bad reply)
#   auto = every other provider that has a key | none = no backups | or a list such as groq,gemini
# If every provider fails, each service falls back to its built-in offline method, so nothing stops working.
LLM_FALLBACK=auto

ANTHROPIC_API_KEY=            # Claude          https://console.anthropic.com
GROQ_API_KEY=                 # Groq (free tier)  https://console.groq.com
GEMINI_API_KEY=               # Gemini (free tier) https://aistudio.google.com

# Models. Provider model names change over time: check each provider's current model list.
KB_ANSWER_MODEL=claude-sonnet-5-5
KB_VISION_MODEL=claude-haiku-5-5
INBOX_CLASSIFY_MODEL=claude-haiku-5-5
INBOX_DRAFT_MODEL=claude-sonnet-5-5
SCOPE_ANALYST_MODEL=claude-sonnet-5-5
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# ---------------- Other settings ----------------
KB_API_KEY=                   # optional shared secret for the Knowledge Brain API (NOT an AI key)
KB_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
