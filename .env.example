# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # optional: without it everything runs in the offline fallback mode
KB_API_KEY=                   # optional shared secret between services (X-API-Key)
KB_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
KB_ANSWER_MODEL=claude-sonnet-5-5
KB_VISION_MODEL=claude-haiku-5-5
